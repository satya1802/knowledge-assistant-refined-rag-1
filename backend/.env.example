# Backend-specific env vars (see the repo-root .env.example for the Postgres
# and Redis values docker-compose.yml provides). Copy what you need into your
# real .env -- never commit a real key.

# Postgres (same variable app/database.py and alembic/env.py both read)
DATABASE_URL=postgresql+psycopg://app:app@db:5432/app

# The Groq AI provider. Read only by app/settings.py, server-side; never
# placed in a response, cookie or template, and there is no frontend env
# var for it (AC-097).
GROQ_API_KEY=replace-with-a-real-groq-api-key

# Provider/model selection (AC-099): change these to switch provider or
# model without a code change. Defaults match app/settings.py.
AI_PROVIDER=groq
ANSWER_MODEL=llama-3.1-8b-instant
EMBEDDING_MODEL=nomic-embed-text-v1.5

# Embedding provider selection (AC-155, app/embedding.py). The choice
# between candidates is an open decision -- see
# backend/docs/decisions/0001-embedding-provider.md -- so EMBEDDING_PROVIDER
# defaults to "none" and app/embedding.py reports itself disabled with a
# clear message until this is set. Once a provider is chosen, set this to
# its name (e.g. "nomic") and set that provider's own
# <NAME>_EMBEDDING_API_KEY (e.g. NOMIC_EMBEDDING_API_KEY) -- never reuse
# GROQ_API_KEY for it. EMBEDDING_DIM must stay 768 to match the
# Chunk.embedding pgvector column; changing it requires a new migration.
EMBEDDING_PROVIDER=none
EMBEDDING_DIM=768

# Bounded retry/backoff for a transient embedding-provider error (AC-046).
# Defaults: 3 retries, 1s base, doubling each attempt (1s, 2s, 4s).
EMBEDDING_MAX_RETRIES=3
EMBEDDING_BACKOFF_BASE_SECONDS=1.0
EMBEDDING_BACKOFF_FACTOR=2.0

# Maximum chunks sent to the embedding provider per call (AC-044).
EMBEDDING_BATCH_SIZE=100
