# Backend-specific env vars (see the repo-root .env.example for the Postgres
# and Redis values docker-compose.yml provides). Copy what you need into your
# real .env -- never commit a real key.

# Postgres (same variable app/database.py and alembic/env.py both read)
DATABASE_URL=postgresql+psycopg://app:app@db:5432/app

# The Groq AI provider. Read only by app/settings.py, server-side; never
# placed in a response, cookie or template, and there is no frontend env
# var for it (AC-097).
GROQ_API_KEY=replace-with-a-real-groq-api-key

# Provider/model selection (AC-099): change these to switch provider or
# model without a code change. Defaults match app/settings.py.
AI_PROVIDER=groq
ANSWER_MODEL=llama-3.1-8b-instant
EMBEDDING_MODEL=nomic-embed-text-v1.5
